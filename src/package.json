{
  "name": "bnb-booking-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.mjs",
    "gen:palette": "node scripts/generate-palette.mjs",
    "check:palette": "node scripts/generate-palette.mjs --check",
    "gen:email-logo": "node scripts/generate-email-logo.mjs",
    "check:email-logo": "node scripts/generate-email-logo.mjs --check",
    "gen:og-image": "node scripts/generate-og-image.mjs",
    "check:og-image": "node scripts/generate-og-image.mjs --check",
    "verify": "npm run lint && npm run check:locales && npm run check:palette && npm run check:email-logo && npm run check:og-image && npm run typecheck",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lint-staged": "^16.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
