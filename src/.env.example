# Copy to .env.local and fill in. Never commit .env.local.
#
# Only secrets and per-deployment values live here. Everything about the
# property itself — its name, address, phone, licence code, capacity, check-in
# times — is in configuration/property.mjs. See docs/Rebranding.md.

# Origin used for canonical, hreflang and Open Graph URLs. Leave unset on
# Vercel: the deployment URL is picked up automatically. Set it (no trailing
# slash) once a custom domain exists, so the tags point at the real address
# rather than at *.vercel.app.
# NEXT_PUBLIC_SITE_URL="https://ilrespirodelborgo.it"

# --- Enquiry form email delivery (lib/email/transport.ts) ---
# Gmail account that sends the mail. Requires 2-Step Verification enabled and
# an App Password (Google Account > Security > App passwords) — a normal
# account password will NOT work.
#
# It must be the same address as `contact.email` in configuration/property.mjs.
# That one is what the footer and the contact page show a guest; this one is what
# the mail is actually sent from and replied to. If they differ, guests write to
# an inbox nobody reads.
SMTP_USER="ilrespirodelborgo@gmail.com"
SMTP_APP_PASSWORD=""

# Where enquiries are delivered. Defaults to SMTP_USER if omitted.
ENQUIRY_TO="ilrespirodelborgo@gmail.com"

# --- Database (db/client.ts) ---
# Optional. Left unset the site runs exactly as it did before persistence
# existed: enquiries are validated and emailed, they are simply not stored.
# Locally, after `npm run db:bootstrap`:
#   postgresql://ilrespirodelborgo_app:ilrespirodelborgo_local_dev@127.0.0.1:5432/ilrespirodelborgo
# On Supabase use the TRANSACTION pooler (port 6543) here.
DATABASE_URL=""

# Migrations only, and only on Supabase: DDL cannot go through the transaction
# pooler, so this is the session-mode URL (port 5432). Leave unset locally —
# DATABASE_URL is used for both.
DIRECT_DATABASE_URL=""

# --- Privacy (lib/privacy/ip.ts) ---
# Salts the SHA-256 of the visitor IP used for abuse prevention. Without it no
# IP hash is stored at all. It is not decorative: an unsalted hash of an IPv4
# address is trivially reversible, and a regulator would treat it as the address
# itself. Any long random string works; rotating it makes every stored hash
# permanently unmatchable, which is a valid way to retire the data early.
IP_HASH_SECRET=""

# --- Retention cron (app/api/cron/anonymise) ---
# Vercel sends this as `Authorization: Bearer <value>` on scheduled runs. Unset
# in production means the endpoint refuses to run rather than running unguarded.
CRON_SECRET=""
