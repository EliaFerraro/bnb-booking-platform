# Copy to .env.local and fill in. Never commit .env.local.

# Shown as the site title and in the enquiry emails.
STRUCTURE_NAME="Il Respiro del Borgo"

# --- Enquiry form email delivery (lib/enquiry/transport.ts) ---
# Gmail account that sends the mail. Requires 2-Step Verification enabled and
# an App Password (Google Account > Security > App passwords) — a normal
# account password will NOT work.
SMTP_USER="ilrespirodelborgobnb@gmail.com"
SMTP_APP_PASSWORD=""

# Where enquiries are delivered. Defaults to SMTP_USER if omitted.
ENQUIRY_TO="ilrespirodelborgobnb@gmail.com"
