#!/bin/sh
#
# Enabled by `git config core.hooksPath .githooks`, which src/package.json runs
# automatically from its "prepare" script on npm install. To wire it up by hand:
#
#     git config core.hooksPath .githooks
#
# The npm project lives in src/ while the git root is one level up, so every
# step below runs from src/. Skip once with `git commit --no-verify`.

set -e

# 0. Fail fast if a filled-in credential is about to be committed. .env.example
#    is deliberately tracked (it documents the required variables), which makes
#    it dangerously easy to paste real values into instead of .env.local.
for staged in $(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env' || true); do
  if git show ":$staged" |
    grep -qE '^[A-Z_]*(PASSWORD|SECRET|TOKEN|CREDENTIAL)[A-Z_]*=("?)[^"[:space:]]+'; then
    echo "pre-commit: $staged holds a non-empty credential." >&2
    echo "            Move the real value to src/.env.local (gitignored)." >&2
    exit 1
  fi
  # A connection string carries its password inline, so it matches none of the
  # keywords above — DATABASE_URL is now the most dangerous line that could be
  # staged. Catches scheme://user:password@host in any *_URL variable, while
  # leaving an empty or passwordless URL alone.
  if git show ":$staged" |
    grep -qE '^[A-Z_]*URL[A-Z_]*=("?)[a-z+]+://[^:@/[:space:]]+:[^@/[:space:]]+@'; then
    echo "pre-commit: $staged holds a connection string with an inline password." >&2
    echo "            Move the real value to src/.env.local (gitignored)." >&2
    exit 1
  fi
done

cd "$(git rev-parse --show-toplevel)/src"

if [ ! -d node_modules ]; then
  echo "pre-commit: src/node_modules is missing — run 'npm install' in src/." >&2
  exit 1
fi

# 1. ESLint with --fix on staged .ts/.tsx only, so the hook stays fast and
#    re-stages anything it repairs. Warnings pass; errors block.
npx --no-install lint-staged

# 2. The five locale files share no type link, so a key added to one and
#    forgotten in another would only fail at runtime.
npm run --silent check:locales

# 3. Every business fact belongs to configuration/property.mjs alone. Typing an
#    address or a phone number straight into a component still compiles, and it
#    is what quietly makes the site unsellable to the next owner.
npm run --silent check:config

# 4. style/palette.css is generated from style/palette.mjs; committing one
#    without the other would silently split the brand palette in two.
npm run --silent check:palette

# 5. lib/email/logo.ts embeds public/img/brand/logo.png; replacing the artwork
#    without regenerating would leave the old logo in every outgoing email.
npm run --silent check:email-logo

# 6. Two migrations generated on separate branches collide silently: same
#    sequence number, divergent snapshots. This is offline — it reads the
#    journal, never the database — so the hook still works with Postgres
#    stopped, which is a hard requirement for every step here.
npm run --silent check:migrations

# 7. Type errors span files that are not staged, so this has to be project-wide.
npm run --silent typecheck

echo "pre-commit: checks passed"
